// Cloudflare Workers Builds deploys this repo with `npx wrangler deploy`.
// Without this file, newer wrangler versions auto-generate a config that
// serves the whole repo, including .git, which breaks the 25 MiB asset limit.
// What gets uploaded is controlled by .assetsignore.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "motivision-media-website",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "."
  }
}
